{
  "appId": "com.orenreic.breathanew",
  "appName": "BreathAnew",
  "webDir": "dist",
  "backgroundColor": "#F6EFE3",
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "automatic"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 900,
      "backgroundColor": "#F6EFE3",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#F6EFE3"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_breathanew",
      "iconColor": "#C4623F"
    }
  }
}
